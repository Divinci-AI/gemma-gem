{
  "name": "divinci-local-inference",
  "description": "In-browser Gemma 4 inference for chat.divinci.app, via WebGPU + an offscreen document. Bridges chrome.runtime ports to a single shared model instance.",
  "license": "Apache-2.0",
  "version": "0.11.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "build:prod": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "pretest": "npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:smoke": "playwright test --config=e2e/playwright.config.ts --project=smoke",
    "e2e:open-api": "playwright test --config=e2e/playwright.config.ts --project=open-api",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.1.42",
    "@types/three": "0.169.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wxt": "^0.20.20"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "three": "0.169.0"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "^7.6.3",
      "@protobufjs/utf8": "^1.1.1",
      "shell-quote": "^1.8.4",
      "tmp": "^0.2.6",
      "vite": "^8.0.16",
      "esbuild": "^0.28.1",
      "postcss": "^8.5.10",
      "uuid": "^11.1.1"
    }
  }
}
